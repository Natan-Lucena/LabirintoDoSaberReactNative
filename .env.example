# Development only. Android emulators can reach the local backend through 10.0.2.2.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Homologation: use EXPO_PUBLIC_APP_ENV=homologation only after its official HTTPS URL is provided.
# Production: use EXPO_PUBLIC_APP_ENV=production and the documented HTTPS API URL.
# No secrets belong in EXPO_PUBLIC_* variables.

# G-29/G-51: mocks are off by default in every environment.
# Set true to use mock data in development; false keeps the real backend. See src/mocks/README.md.
# EXPO_PUBLIC_USE_MOCKS=true

# Backend real (deploy de teste do grupo; Swagger em /api-docs/). Para usar esse deploy,
# troque a URL acima pela linha abaixo; mocks já ficam desligados por padrão. Reinicie com
# `pnpm start --clear` (o Expo só lê o .env ao subir). Use uma conta existente ou crie uma com
# POST /educator/register.
# EXPO_PUBLIC_API_BASE_URL=https://labirinto-do-saber.vercel.app
# EXPO_PUBLIC_USE_MOCKS=false
